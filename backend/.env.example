# Server Port
PORT=5000

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Note: If MONGODB_URI is left as is and local MongoDB is unavailable, 
# PathNova AI will automatically spawn an in-memory database for seamless local testing.
MONGODB_URI=mongodb://127.0.0.1:27017/pathnova_db

# JWT Secret Key for Token Signing
JWT_SECRET=pathnova_super_secret_jwt_token_key_2026_xyz

# Gemini / OpenAI AI API Key (Optional)
# If provided, Gemini AI generates dynamic career insights and chatbot responses.
# If left empty, PathNova AI seamlessly switches to its built-in rule-based expert recommendation engine.
AI_API_KEY=
